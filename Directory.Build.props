<Project>

  <!--
    Shared build settings for every tutorial project in this repo.
    - Target .NET 8.0 (LTS) by default. Set TutorialTargetFramework to validate
      the same examples on another supported runtime. The SDK ships as netstandard2.0.
    - C# latest so examples can use file-scoped namespaces, top-level statements,
      and collection expressions without ceremony.
    - ImplicitUsings brings in the common BCL namespaces; Program.cs stays short.
  -->

  <PropertyGroup>
    <TutorialTargetFramework Condition="'$(TutorialTargetFramework)' == ''">net8.0</TutorialTargetFramework>
    <TargetFramework>$(TutorialTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Pin the SDK version for the whole repo in one place. Override in an
    individual project by setting <AsposeLLMVersion> before Import happens,
    or by replacing the PackageReference outright.
  -->
  <PropertyGroup>
    <AsposeLLMVersion Condition="'$(AsposeLLMVersion)' == ''">26.11.0</AsposeLLMVersion>
  </PropertyGroup>

  <!--
    Keep System.Text.Json 9.0.0 explicit on .NET 8/9 for the SDK's dependency.
    On .NET 10 the direct reference is redundant and triggers NU1510; the SDK
    package still declares its own transitive dependency.
  -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.0" Condition="'$(TutorialTargetFramework)' != 'net10.0'" />
  </ItemGroup>

</Project>
