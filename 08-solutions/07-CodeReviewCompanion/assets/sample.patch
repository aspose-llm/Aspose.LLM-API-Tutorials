--- a/src/Data/UserRepository.cs
+++ b/src/Data/UserRepository.cs
@@ -42,6 +42,18 @@ namespace Acme.Data
             return await cmd.ExecuteScalarAsync() as string;
         }

+        public async Task<UserRecord?> FindByEmailAsync(string email)
+        {
+            using var conn = _factory.Open();
+            var sql = "SELECT id, email, role FROM users WHERE email = '" + email + "'";
+            using var cmd = new SqlCommand(sql, conn);
+            using var r = await cmd.ExecuteReaderAsync();
+            if (!await r.ReadAsync())
+            {
+                return null;
+            }
+            return new UserRecord(r.GetInt64(0), r.GetString(1), r.GetString(2));
+        }
     }
 }
