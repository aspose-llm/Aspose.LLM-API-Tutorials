 using System;
+using System.Threading;
 using System.Threading.Tasks;
+using Halyard.Audit;

 namespace Halyard.Auth;

 public sealed class LoginHandler
 {
+    private static readonly TimeSpan FailureWindow  = TimeSpan.FromMinutes(15);
+    private static readonly TimeSpan LockoutPeriod  = TimeSpan.FromMinutes(15);
+    private const int MaxFailedAttempts = 5;
+
     private readonly IPasswordHasher _hasher;
     private readonly IUserRepository _users;
+    private readonly IAccountLockoutStore _lockouts;
+    private readonly IAuditLog _audit;

-    public LoginHandler(IPasswordHasher hasher, IUserRepository users)
+    public LoginHandler(
+        IPasswordHasher hasher,
+        IUserRepository users,
+        IAccountLockoutStore lockouts,
+        IAuditLog audit)
     {
         _hasher = hasher;
         _users = users;
+        _lockouts = lockouts;
+        _audit = audit;
     }

-    public async Task<LoginResult> HandleAsync(string accountId, string password)
+    public async Task<LoginResult> HandleAsync(
+        string accountId,
+        string password,
+        CancellationToken ct = default)
     {
+        var lockedUntil = await _lockouts.GetLockoutUntilAsync(accountId, ct);
+        if (lockedUntil is { } until && until > DateTimeOffset.UtcNow)
+            return LoginResult.Locked(until);
+
         var user = await _users.FindAsync(accountId);
         if (user is null) return LoginResult.Unauthorized();

         if (!_hasher.Verify(password, user.PasswordHash))
+        {
+            var failures = await _lockouts.IncrementFailureAsync(accountId, FailureWindow, ct);
+            if (failures >= MaxFailedAttempts)
+            {
+                await _lockouts.LockAsync(accountId, LockoutPeriod, ct);
+                await _audit.WriteAsync(new AccountLockedOutEvent(accountId, DateTimeOffset.UtcNow), ct);
+                return LoginResult.Locked(DateTimeOffset.UtcNow + LockoutPeriod);
+            }
             return LoginResult.Unauthorized();
+        }

+        await _lockouts.ResetAsync(accountId, ct);
         return LoginResult.Success(user);
     }
 }
