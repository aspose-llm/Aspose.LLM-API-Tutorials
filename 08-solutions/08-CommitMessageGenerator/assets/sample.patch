+
+    [Fact]
+    public async Task HandleLockout_AfterFiveConsecutiveFailures_LocksTheAccount()
+    {
+        var sut = BuildSut(out var lockouts, out var audit);
+        for (int i = 0; i < 5; i++)
+            await sut.HandleAsync("u-1", "wrong");
+
+        var result = await sut.HandleAsync("u-1", "wrong");
+
+        Assert.Equal(LoginOutcome.Locked, result.Outcome);
+        Assert.Single(audit.Written, e => e is AccountLockedOutEvent);
+        Assert.NotNull(result.LockedUntil);
+    }
+
+    [Fact]
+    public async Task HandleLockout_SuccessfulLoginResetsCounter()
+    {
+        var sut = BuildSut(out var lockouts, out _);
+        await sut.HandleAsync("u-1", "wrong");
+        await sut.HandleAsync("u-1", "wrong");
+        await sut.HandleAsync("u-1", "correct-password");
+
+        Assert.Equal(0, await lockouts.PeekFailuresAsync("u-1"));
+    }
 }
