+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Halyard.Auth;
+
+/// <summary>
+/// Persists per-account failed-login counters and lockout deadlines.
+/// Backed by Redis in production; an in-memory implementation is used in tests.
+/// </summary>
+public interface IAccountLockoutStore
+{
+    Task<int> IncrementFailureAsync(string accountId, TimeSpan window, CancellationToken ct);
+
+    Task<DateTimeOffset?> GetLockoutUntilAsync(string accountId, CancellationToken ct);
+
+    Task LockAsync(string accountId, TimeSpan duration, CancellationToken ct);
+
+    Task ResetAsync(string accountId, CancellationToken ct);
+}
