<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aspose.LLM.Tutorials.EmailReplyAssistant</RootNamespace>
    <AssemblyName>EmailReplyAssistant</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspose.LLM" Version="$(AsposeLLMVersion)" />
    <ProjectReference Include="..\..\_shared\Aspose.LLM.Tutorials.Common\Aspose.LLM.Tutorials.Common.csproj" />
  </ItemGroup>

  <!-- Ship the bundled sample next to the built executable so `dotnet run`
       works out of the box without a path argument. -->
  <ItemGroup>
    <None Update="assets\incoming-sample.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
